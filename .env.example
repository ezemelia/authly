POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
# Solo si NO tenés la clave del backend: generá tu propio par con sufijo -local
# y descomentá estas dos líneas.
# JWT_PRIVATE_KEY_PATH=keys/private_key-local.pem
# JWT_PUBLIC_KEY_PATH=keys/public_key-local.pem

# Base de datos (Supabase): Project Settings > Database > Connection string > Session pooler
# (el host directo db.<ref>.supabase.co es solo IPv6 y Docker en Mac suele no llegar)
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<tu-password>
DB_SSLMODE=require

# Clave para hashear los códigos de verificación (HMAC). Texto aleatorio largo, NUNCA en el repo.
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
CODIGO_HMAC_KEY=<texto-aleatorio-largo>
# Remitente de los emails (opcional)
# SMTP_FROM=no-reply@authly.local
